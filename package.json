{
  "name": "wordbyword-web",
  "version": "2.0.0",
  "private": true,
  "description": "Official website for WordByWord — www.word-by-word.app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --pseudo && node scripts/check.mjs",
    "check:keys": "node scripts/check.mjs --keys",
    "check:external": "node scripts/check.mjs --external",
    "test": "node --test scripts/tests/*.test.mjs",
    "serve": "node build.mjs && node scripts/serve.mjs --port 4580",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:dry": "node build.mjs && node scripts/indexnow.mjs --dry-run --sitemap-file dist/sitemap.xml",
    "contract": "node build.mjs && bash scripts/contract-test.sh",
    "verify": "node build.mjs && bash scripts/verify-deploy.sh",
    "serve:cf": "node build.mjs && npx --yes wrangler pages dev dist --port 8788",
    "images": "node scripts/images.mjs && node scripts/check-images.mjs --render",
    "images:check": "node scripts/check-images.mjs",
    "images:prune": "node scripts/images.mjs --prune",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "node scripts/og.mjs"
  }
}

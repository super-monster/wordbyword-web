{
  "$comment": [
    "Product-claim lint (doc 06 §3.7 L-14 / D-15a, §4.3; ENG-10). Seeds: doc 03 §1.4 + §3.8 CLAIM_SEED, doc 08 §1.1 red lines and §7.5 banned phrases, F11/F14/F16, R26, R28, R40, R41, R45, H13.",
    "patterns: regex sources per locale code; '*' applies to every locale. Matched case-insensitively against each leaf value with placeholders filled and markup stripped.",
    "exempt: key paths (wildcards: [*] / .*; a path also covers its subtree) where the phrase is allowed, e.g. the negative FAQ answers. exemptPrefix: key-path prefixes. only: the rule applies only under these key paths.",
    "A published locale with neither its own patterns nor '*' patterns for a rule gets a W 'not covered' (L-14) so reviewers check it by hand (R36).",
    "When a translator delivers a locale, add its wording to every rule (doc 08 §7.5)."
  ],
  "rules": [
    {
      "id": "whole-page",
      "desc": "One-tap / whole-page translation does not exist: WordByWord translates the paragraph you swipe (F14, baseline §B2, doc 08 §7.5 no-feature)",
      "patterns": {
        "en": ["translat\\w* (a |the )?(whole|entire|full) (web ?)?page", "one[- ]tap translat", "(whole|entire|full)[- ]page translation", "translat\\w* (an |the )?entire (web)?site"],
        "zh-Hans": ["一键翻译整", "整页翻译", "翻译整个(网页|页面)", "自动翻译整"],
        "zh-Hant": ["一鍵翻譯整", "整頁翻譯", "翻譯整個(網頁|頁面)", "自動翻譯整"],
        "ja": ["ページ全体を(一括|一度に|まるごと)", "ワンタップで翻訳", "ページ全体の翻訳", "丸ごと翻訳"],
        "ko": ["페이지 전체(를)? (한 번에 )?번역", "원탭 번역"],
        "es": ["traduc\\w* (toda |una |la )?(la )?página (web )?(entera|completa)", "página (web )?(entera|completa) de una vez", "traducción de (páginas?|webs?|sitios?)( web)? (enteras?|completas?)", "(con|en) un (solo )?toque", "traduc\\w* (todo el|un) sitio (web )?(entero|completo)"],
        "fr": ["tradui\\w* (toute la|toute une|une|la) page( web)? (entière|complète|d[’']un (seul )?coup)", "tradui\\w* toute (la|une) page", "\\bpages? (web )?(entières?|complètes?)", "en un (seul )?(toucher|geste|clic)", "traduction de (la|toute la) page"]
      },
      "exempt": ["faq.items[whole-page]", "about.sections[limits].text", "about.facts[*].value"],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "swipe-left",
      "desc": "The gesture is a right swipe; a left swipe removes the translation (F14, doc 08 §7.7)",
      "patterns": {
        "en": ["swipe (to the )?left", "left[- ]swipe"],
        "zh-Hans": ["左滑", "向左滑"],
        "zh-Hant": ["左滑", "向左滑"],
        "ja": ["左に?スワイプ"],
        "ko": ["왼쪽으로 (밀|스와이프)"],
        "es": ["desliz\\w*[^.;:]{0,30}izquierda"],
        "fr": ["(balay|gliss)\\w*(\\s+\\S+){0,3}\\s+(vers la gauche|à gauche)"]
      },
      "exempt": []
    },
    {
      "id": "safari-extension",
      "desc": "Not a Safari extension or share extension, no translate button in other apps (F13, doc 08 §1.1)",
      "patterns": {
        "en": ["safari extension", "share extension", "in (any|every) (other )?app\\b", "inside (any|other) apps?", "from any app", "without switching apps"],
        "zh-Hans": ["Safari ?扩展", "分享扩展", "在任何 ?App ?(里|中)", "任意 ?App ?(里|中)", "无需切换 ?App"],
        "zh-Hant": ["Safari ?(延伸功能|擴充)", "分享延伸功能", "在任何 ?App ?(裡|中)", "無需切換 ?App"],
        "ja": ["Safari ?拡張", "共有拡張", "どのアプリでも", "アプリを切り替えずに"],
        "ko": ["(사파리|Safari) 확장", "공유 확장", "어떤 앱에서(든|나)"],
        "es": ["extensión (de|para) Safari", "extensión (para|de) compartir", "en cualquier (otra )?app\\b", "dentro de (cualquier|otras) apps?", "desde cualquier app", "sin cambiar de app"],
        "fr": ["extension (pour |de )?safari", "extension de partage", "dans (n[’']importe quelle|toutes? les|chaque) (autre )?app", "sans changer d[’']app"]
      },
      "exempt": ["faq.items[safari]", "about.sections[limits].text"],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "selection-translate",
      "desc": "No select-to-translate in the iOS app (doc 08 §7.5 no-feature; the Chrome extension does have it)",
      "patterns": {
        "en": ["select(ing)? (any )?(text|a word|words|a sentence) to translate", "highlight (text )?to translate", "translat\\w* (on|as you) select"],
        "zh-Hans": ["划词", "选中即译", "选中(文字|文本)?(即|就)可?翻译"],
        "zh-Hant": ["劃詞", "選取即譯", "選取(文字)?(即|就)可?翻譯"],
        "ja": ["選択して翻訳", "選択するだけで翻訳"],
        "ko": ["선택(하면|해서) 번역", "드래그(하면|해서) 번역"],
        "it": ["selezionando", "selezion\\w* (il |un |del )?test\\w* (per|e) tradurr"],
        "pl": ["zaznaczeni", "zaznacz\\w* tekst"],
        "ru": ["при выделении", "выдел\\w* текст"],
        "tr": ["seçerek", "metni seç"],
        "pt-BR": ["ao selecionar", "selecion\\w* (o |um )?texto (para|e) traduzir"],
        "hi": ["चुनते ही", "टेक्स्ट चुन"],
        "ar": ["عند تحديد", "(حدد|تحديد) (ال)?نص"],
        "es": ["selecciona\\w* (el |un )?texto (para|y) traducir"],
        "fr": ["sélectionn\\w* (le |du |un )?texte (pour|et) (le )?tradui"],
        "de": ["text (markieren|auswählen),? um (ihn )?zu übersetzen"],
        "uk": ["виділ\\w* текст", "при виділенні"]
      },
      "exempt": [],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "offline",
      "desc": "Never claim offline use: unverified for WordByWord (H13, doc 08 D7); never an SE-only selling point either (R41)",
      "patterns": {
        "en": ["\\boffline\\b", "without (an )?internet", "no internet (connection )?(needed|required)"],
        "zh-Hans": ["离线", "无网", "断网", "不联网"],
        "zh-Hant": ["離線", "無網路", "不需網路"],
        "ja": ["オフライン", "ネット(接続)?なしで"],
        "ko": ["오프라인", "인터넷 없이"],
        "es": ["sin conexión", "\\boffline\\b", "sin (acceso a )?internet", "fuera de línea"],
        "fr": ["hors[ -]ligne", "hors[ -]connexion", "sans (connexion( internet)?|internet|réseau)"]
      },
      "exempt": []
    },
    {
      "id": "unlimited-ai-voice",
      "desc": "No unlimited AI pronunciation; only the local engine (Plus) and iOS voices have no daily limit (F16)",
      "patterns": {
        "en": ["unlimited ai", "unlimited (pronunciation|read(ing)?|speech|voices?)", "ai (pronunciation|voices?|read) without (a )?limit"],
        "zh-Hans": ["无限\\s*次?\\s*AI", "AI\\s*(发音|朗读)\\s*(无限|不限)"],
        "zh-Hant": ["無限\\s*次?\\s*AI", "AI\\s*(發音|朗讀)\\s*(無限|不限)"],
        "ja": ["無制限のAI", "AI(読み上げ|発音)[^。]{0,6}無制限"],
        "ko": ["무제한 AI", "AI (발음|읽기) 무제한"],
        "es": ["(IA|AI) ilimitad", "(pronunciación|lectura|voz|voces)( con| de)? (IA|AI) (ilimitad|sin límite)", "ilimitad\\w* (de |con )?(IA|AI)"],
        "fr": ["ia illimitée", "illimit\\w* (de )?(prononciation|lecture|voix)", "(prononciation|lecture|voix)\\w*( \\w+)? (ia|ai) illimit"]
      },
      "exempt": []
    },
    {
      "id": "dark-mode-theme",
      "desc": "No dark mode, themes or theme colours in the iOS app (F11, F16, doc 08 §1.1)",
      "patterns": {
        "en": ["dark mode", "night mode", "custom (colou?r )?themes?", "theme colou?rs?"],
        "zh-Hans": ["暗色模式", "深色模式", "夜间模式", "自定义主题", "主题色", "更换主题"],
        "zh-Hant": ["暗色模式", "深色模式", "夜間模式", "自訂主題", "主題色"],
        "ja": ["ダークモード", "テーマ(カラー|色)", "着せ替え"],
        "ko": ["다크 ?모드", "테마 (색|변경)"],
        "es": ["modo oscuro", "modo noche", "temas? personalizad", "colou?r(es)? de(l)? tema"],
        "fr": ["mode (sombre|nuit)", "thèmes? personnalis", "couleurs? de thème", "thème de couleur"]
      },
      "exempt": [],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "shortcuts-volume",
      "desc": "No keyboard shortcuts or volume control in the iOS app (baseline §B2)",
      "patterns": {
        "en": ["keyboard shortcuts?", "volume (control|slider|adjust\\w*)", "adjust(able)? (the )?volume"],
        "zh-Hans": ["快捷键", "音量"],
        "zh-Hant": ["快捷鍵", "音量"],
        "ja": ["ショートカット(キー)?", "音量"],
        "ko": ["단축키", "볼륨"],
        "es": ["atajos? de teclado", "volumen"],
        "fr": ["raccourcis? (clavier|de traduction)", "(réglage|contrôle|curseur) du volume", "régler le volume"]
      },
      "exempt": [],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "vocab-sync",
      "desc": "No word book, flashcards, accounts or cloud sync in WordByWord (doc 08 §1.1 history / account rows)",
      "patterns": {
        "en": ["flash ?cards?", "vocabulary (book|list|notebook)", "word ?book", "(cloud|account|icloud) (sync|backup)", "sync(ed|s)? across (your )?devices", "spaced repetition"],
        "zh-Hans": ["生词本", "单词本", "闪卡", "(云端|账号|iCloud)\\s*(同步|备份)", "多设备同步"],
        "zh-Hant": ["生詞本", "單字本", "閃卡", "(雲端|帳號|iCloud)\\s*(同步|備份)"],
        "ja": ["単語帳", "フラッシュカード", "(クラウド|アカウント|iCloud)\\s*(同期|バックアップ)"],
        "ko": ["단어장", "플래시 ?카드", "(클라우드|계정) (동기화|백업)"],
        "es": ["tarjetas de (memoria|estudio)", "flash ?cards?", "(cuaderno|lista|libreta) de vocabulario", "sincroniz\\w*", "copia de seguridad en la nube", "repetición espaciada"],
        "fr": ["flash ?cards?", "fiches? (de révision|mémo)", "(carnet|liste) de vocabulaire", "synchronis\\w* (icloud|du compte|entre (vos )?appareils|dans le cloud)", "sauvegarde (icloud|dans le cloud)", "répétition espacée"]
      },
      "exempt": []
    },
    {
      "id": "android",
      "desc": "There is no Android version (F13, R73)",
      "patterns": {
        "en": ["android (version|app|phone)", "on android", "for android", "google play"],
        "zh-Hans": ["安卓", "Android\\s*版", "Google Play"],
        "zh-Hant": ["安卓", "Android\\s*版", "Google Play"],
        "ja": ["Android(版|アプリ|端末)", "Google Play"],
        "ko": ["안드로이드", "구글 플레이"],
        "es": ["android", "google play"],
        "fr": ["version android", "sur android", "pour android", "appli(cation)? android", "google play"]
      },
      "exempt": ["faq.items[android]"]
    },
    {
      "id": "desktop-version",
      "desc": "No web or desktop version of WordByWord; the Chrome extension is a separate product (F13, R45)",
      "patterns": {
        "en": ["\\bweb version of wordbyword", "desktop (app|version)\\b", "for (windows|pc)\\b"],
        "zh-Hans": ["电脑版", "桌面版", "Windows\\s*版", "PC\\s*版"],
        "zh-Hant": ["電腦版", "桌面版", "Windows\\s*版", "PC\\s*版"],
        "ja": ["(PC|パソコン|デスクトップ)版", "Windows版"],
        "ko": ["(PC|데스크톱) 버전", "윈도우 버전"],
        "es": ["versión (de|para) (escritorio|PC|Windows|ordenador|computadora)", "app de escritorio", "para (Windows|PC)\\b"],
        "fr": ["version (pour )?(ordinateur|pc|windows|de bureau)", "application de bureau", "pour (windows|pc)\\b"]
      },
      "exempt": ["faq.items[devices]", "faq.items[android]"],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "x-app",
      "desc": "X works in the built-in browser (x.com), not in the X app; never 'the only app that translates X' (doc 08 §1.1)",
      "patterns": {
        "en": ["\\b(in|inside) the x app", "only app (that|to) translat\\w* x\\b"],
        "zh-Hans": ["在\\s*X\\s*App\\s*(里|中)(翻译|使用)", "唯一能翻译\\s*X"],
        "zh-Hant": ["在\\s*X\\s*App\\s*(裡|中)(翻譯|使用)", "唯一能翻譯\\s*X"],
        "ja": ["Xアプリ(で|内で|の中で)翻訳", "Xを翻訳できる唯一"],
        "ko": ["X 앱에서 번역"],
        "es": ["(en|dentro de) la app de X\\b", "única app (que|para) traduc\\w* X\\b"],
        "fr": ["dans l[’']app(lication)? x\\b", "seule app\\w* (qui|à) tradui\\w* x\\b"]
      },
      "exempt": ["faq.items[x]"]
    },
    {
      "id": "plus-early-access",
      "desc": "'Plus gets new features first' has no implementation in the app (doc 08 §1.1)",
      "patterns": {
        "en": ["early access"],
        "zh-Hans": ["抢先体验"],
        "zh-Hant": ["搶先體驗"],
        "ja": ["先行(体験|アクセス|利用)"],
        "ko": ["얼리 ?액세스", "먼저 체험"],
        "es": ["acceso anticipado"],
        "fr": ["accès anticipé", "en avant-première"]
      },
      "exempt": []
    },
    {
      "id": "privacy-claim",
      "desc": "No privacy assertions in copy (F17, H6, doc 01 C-11)",
      "patterns": {
        "en": ["no personal data", "(does not|doesn't|never|won't) collect (any )?(personal )?(data|information)", "no tracking", "(we|it) (do|does) not track"],
        "zh-Hans": ["不收集任何", "不收集(你的|您的)?个人", "无追踪", "不追踪"],
        "zh-Hant": ["不收集任何", "不收集(你的|您的)?個人", "無追蹤", "不追蹤"],
        "ja": ["個人情報(は|を)一切", "一切収集し", "トラッキングなし"],
        "ko": ["개인 ?정보를 (전혀 )?수집하지 않", "추적하지 않"],
        "es": ["no (se )?recopila\\w* (ningún |ninguna )?(dato|información)", "sin rastreo", "no (te )?rastrea"],
        "fr": ["aucune donnée (personnelle|collectée)", "ne collecte (aucune|pas de|jamais de) (donnée|information)", "sans (pistage|traçage|suivi publicitaire)", "aucun (pistage|traçage)"]
      },
      "exempt": []
    },
    {
      "id": "initial-version",
      "desc": "Wrong fact: 'initial version' wording from the legacy site (doc 01 C-05)",
      "patterns": {
        "en": ["initial version"],
        "zh-Hans": ["初始版本"],
        "zh-Hant": ["初始版本"],
        "ja": ["初期バージョン"],
        "ko": ["초기 버전"],
        "es": ["versión inicial"],
        "fr": ["version initiale"]
      },
      "exempt": []
    },
    {
      "id": "language-pairs",
      "desc": "Wrong fact: '20+ language pairs' — WordByWord translates into {targetLanguages} languages (doc 01 C-04)",
      "patterns": {
        "en": ["language pairs?"],
        "zh-Hans": ["语言对"],
        "zh-Hant": ["語言對"],
        "ja": ["言語ペア"],
        "ko": ["언어 쌍"],
        "es": ["pares? de idiomas"],
        "fr": ["paires? de langues"]
      },
      "exempt": []
    },
    {
      "id": "style-count",
      "desc": "Never state how many translation styles there are (R26)",
      "patterns": {
        "en": ["\\b\\d+ (different |translation |display )?styles", "\\b(five|six|seven|eight|nine|ten) (different |translation |display )?styles"],
        "zh-Hans": ["\\d+\\s*种(译文|翻译|显示)?样式", "[五六七八九十]种(译文|翻译|显示)?样式"],
        "zh-Hant": ["\\d+\\s*種(譯文|翻譯|顯示)?樣式", "[五六七八九十]種(譯文|翻譯|顯示)?樣式"],
        "ja": ["\\d+種類?の(スタイル|表示)"],
        "ko": ["\\d+가지 (스타일|표시)"],
        "es": ["\\b\\d+ estilos", "\\b(cinco|seis|siete|ocho|nueve|diez) estilos"],
        "fr": ["\\b\\d+ styles", "\\b(cinq|six|sept|huit|neuf|dix) styles"]
      },
      "exempt": []
    },
    {
      "id": "auto-detect-target",
      "desc": "Wrong fact: the app detects the page (source) language, not the target language (doc 01 C-06)",
      "patterns": {
        "en": ["detects? (your|the) target language", "automatic(ally)? detects? (your|the) target"],
        "zh-Hans": ["自动(检测|识别)目标语言"],
        "zh-Hant": ["自動(偵測|檢測|識別)目標語言"],
        "ja": ["(翻訳先|ターゲット言語)[^。]{0,8}自動(検出|判定|検知)"],

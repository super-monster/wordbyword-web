        "en": ["swipe (to the )?left", "left[- ]swipe"],
        "zh-Hans": ["左滑", "向左滑"],
        "zh-Hant": ["左滑", "向左滑"],
        "ja": ["左に?スワイプ"],
        "ko": ["왼쪽으로 (밀|스와이프)"],
        "es": ["desliz\\w*[^.;:]{0,30}izquierda"],
        "fr": ["(balay|gliss)\\w*(\\s+\\S+){0,3}\\s+(vers la gauche|à gauche)"],
        "pt-BR": ["desliz\\w*[^.;:!?]{0,30}esquerda", "para a esquerda"],
        "de": ["nach links (zu )?wisch", "wisch\\w* (\\S+ ){0,4}nach links", "links-?wisch"],
        "it": ["(scorr\\w*|swip\\w*)[^.;:]{0,30}(a|verso) sinistra"],
        "nl": ["(?<![\\p{L}])(veeg|veegt|vegen|swipe|swipen|swipet)\\w*(\\s+\\S+){0,4}\\s+naar links", "(?<![\\p{L}])(naar )?links (vegen|swipen)", "(?<![\\p{L}])linksveeg"],
        "pl": ["przesu\\p{L}*(\\s+\\S+){0,3}\\s+w\\s+lewo", "w\\s+lewo\\s+przesu", "(przesunięci\\p{L}*|gest\\p{L}*|ruch\\p{L}*)\\s+w\\s+lewo"]
      },
      "exempt": []
    },
    {

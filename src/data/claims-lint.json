        "fr": ["extension (pour |de )?safari", "extension de partage", "dans (n[’']importe quelle|toutes? les|chaque) (autre )?app", "sans changer d[’']app"],
        "pt-BR": ["extensão (do|para o) safari", "extensão de compartilhamento", "em qualquer (outro )?app\\b", "dentro de (qualquer|outros) apps?\\b", "sem (trocar|mudar|sair) de app"],
        "de": ["safari-?erweiterung", "share-?extension", "teilen-?erweiterung", "in (jeder|allen) (anderen )?apps?\\b", "aus jeder app", "ohne (die )?apps? zu wechseln", "ohne app-?wechsel"],
        "it": ["estensione (per |di )?safari", "estensione (di|per la) condivisione", "in (qualsiasi|ogni) (altra )?app(?![\\p{L}])", "in tutte le (altre )?app(?![\\p{L}])", "da qualsiasi (altra )?app(?![\\p{L}])", "senza cambiare app"],
        "nl": ["safari[- ]?(extensie|uitbreiding)", "extensie voor safari", "(?<![\\p{L}])(deel|share)[- ]?extensie", "(?<![\\p{L}])in (elke|iedere|alle|willekeurige) (andere )?apps?(?![\\p{L}])", "(?<![\\p{L}])vanuit (elke|iedere|alle) (andere )?apps?(?![\\p{L}])", "(?<![\\p{L}])(niet|zonder) (van )?apps? te (wisselen|switchen)"],
        "pl": ["rozszerzeni\\p{L}*\\s+(do\\s+|dla\\s+)?safari", "rozszerzeni\\p{L}*\\s+(do\\s+)?udostępniania", "w\\s+(każdej|dowolnej|innej|innych|wszystkich)\\s+(innej\\s+|innych\\s+)?aplikacj", "bez\\s+(przełączania|zmiany|zmieniania)\\s+aplikacj"]
      },
      "exempt": ["faq.items[safari]", "about.sections[limits].text"],
      "exemptPrefix": ["chromeExtension."]
    },
    {

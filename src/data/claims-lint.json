{
  "$comment": [
    "Product-claim lint (doc 06 §3.7 L-14 / D-15a, §4.3; ENG-10). Seeds: doc 03 §1.4 + §3.8 CLAIM_SEED, doc 08 §1.1 red lines and §7.5 banned phrases, F11/F14/F16, R26, R28, R40, R41, R45, H13.",
    "patterns: regex sources per locale code; '*' applies to every locale. Matched case-insensitively against each leaf value with placeholders filled and markup stripped.",
    "exempt: key paths (wildcards: [*] / .*; a path also covers its subtree) where the phrase is allowed, e.g. the negative FAQ answers. exemptPrefix: key-path prefixes. only: the rule applies only under these key paths.",
    "A published locale with neither its own patterns nor '*' patterns for a rule gets a W 'not covered' (L-14) so reviewers check it by hand (R36).",
    "When a translator delivers a locale, add its wording to every rule (doc 08 §7.5)."
  ],
  "rules": [
    {
      "id": "whole-page",
      "desc": "One-tap / whole-page translation does not exist: WordByWord translates the paragraph you swipe (F14, baseline §B2, doc 08 §7.5 no-feature)",
      "patterns": {
        "en": ["translat\\w* (a |the )?(whole|entire|full) (web ?)?page", "one[- ]tap translat", "(whole|entire|full)[- ]page translation", "translat\\w* (an |the )?entire (web)?site"],
        "zh-Hans": ["一键翻译整", "整页翻译", "翻译整个(网页|页面)", "自动翻译整"],
        "zh-Hant": ["一鍵翻譯整", "整頁翻譯", "翻譯整個(網頁|頁面)", "自動翻譯整"],
        "ja": ["ページ全体を(一括|一度に|まるごと)", "ワンタップで翻訳", "ページ全体の翻訳", "丸ごと翻訳"],
        "ko": ["페이지 전체(를)? (한 번에 )?번역", "원탭 번역"],
        "es": ["traduc\\w* (toda |una |la )?(la )?página (web )?(entera|completa)", "página (web )?(entera|completa) de una vez", "traducción de (páginas?|webs?|sitios?)( web)? (enteras?|completas?)", "(con|en) un (solo )?toque", "traduc\\w* (todo el|un) sitio (web )?(entero|completo)"],
        "fr": ["tradui\\w* (toute la|toute une|une|la) page( web)? (entière|complète|d[’']un (seul )?coup)", "tradui\\w* toute (la|une) page", "\\bpages? (web )?(entières?|complètes?)", "en un (seul )?(toucher|geste|clic)", "traduction de (la|toute la) page"],
        "pt-BR": ["tradu\\w* (a |uma )?página( da web)? inteira", "tradu\\w* (o |um )?site inteiro", "página (da web )?inteira de uma (só )?vez", "tradução de páginas? inteiras?", "tradu\\w* com (apenas )?um (só )?toque", "um toque para traduzir"],
        "de": ["(ganze|gesamte|komplette)n? (web)?seiten? (auf einmal |mit einem (tipp|klick) )?(zu )?übersetz", "übersetz\\w* (die |eine )?(ganze|gesamte|komplette)n? (web)?seite", "(ganze|gesamte|komplette)n? (web)?seiten? (auf einmal|mit einem (tipp|klick))", "mit einem (tipp|klick) übersetz", "ganzseiten-?übersetzung", "ganze websites? (zu )?übersetz"],
        "it": ["tradu\\w* (un['’]|l['’])intera pagina", "tradu\\w* (tutta la|una|la) pagina( web)? (intera|completa)", "tradu\\w* tutt[ae] l[ae] pagin[ae]", "pagin[ae] (web )?(intera|intere|completa|complete)(?![\\p{L}])", "tradu\\w* (con|in) un (solo )?tocco", "traduzione (dell['’]intera|di tutta la|di intere) pagin", "tradu\\w* (un['’]|l['’])?intero sito"],
        "nl": ["(?<![\\p{L}])(hele|gehele|volledige|complete) (web)?(pagina|site)(’s|'s|s)? (in één keer |ineens |direct )?(te )?vertaa?l", "(?<![\\p{L}])vertaal\\w* (in één keer |ineens )?(een |de |je )?(hele|gehele|volledige|complete) (web)?(pagina|site)", "(?<![\\p{L}])(met|in) één (tik|klik|tap)(?![\\p{L}])", "(?<![\\p{L}])(volledige |hele )?paginavertaling"],
        "pl": ["tłumacz\\p{L}*\\s+(całą|całe|całej|całych|cały)\\s+(stron|witryn|serwis)", "(cał\\p{L}*|pełn\\p{L}*)\\s+(stron\\p{L}*|witryn\\p{L}*)(\\s+\\S+)?\\s+(naraz|na\\s+raz|od\\s+razu|jednym\\s+\\p{L}+)", "jednym\\s+(dotknięciem|kliknięciem|stuknięciem)", "(stron\\p{L}*|witryn\\p{L}*)\\s+w\\s+całości"]
      },
      "exempt": ["faq.items[whole-page]", "about.sections[limits].text", "about.facts[*].value"],
      "exemptPrefix": ["chromeExtension."]
    },
    {
      "id": "swipe-left",
      "desc": "The gesture is a right swipe; a left swipe removes the translation (F14, doc 08 §7.7)",
